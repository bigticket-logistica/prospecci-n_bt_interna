{
  "appId": "mx.bigticket.portal",
  "appName": "Bigticket",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#002E5D"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#002E5DFF",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashImmersive": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#002E5D",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
